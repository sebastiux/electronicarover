(version 1)
# Fresa de 1.0 mm: entre pistas, plano y piezas hay 2.0 mm. Excepciones: lo que va a paso de
# 2.54 mm (pads vecinos de un header y los rieles de los headers de servo) queda a 1.14 mm.
(rule "pads de una misma pieza"
  (constraint clearance (min 1.10mm))
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Parent == B.Parent"))
(rule "pista junto al pad vecino de su pin"
  (constraint clearance (min 1.30mm))
  (condition "A.Type == 'Track' && B.Type == 'Pad'"))
(rule "pistas que salen de pines vecinos"
  (constraint clearance (min 1.50mm))
  (condition "A.Type == 'Track' && B.Type == 'Track'"))
(rule "rieles de los headers de servo"
  (constraint clearance (min 1.10mm))
  (condition "A.NetName == 'SERVO_V' && A.Type != 'Zone' && ((B.NetName == 'GND' && B.Type == 'Track') || B.Type == 'Pad')"))
